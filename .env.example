# Salin file ini menjadi .env lalu sesuaikan nilainya
APP_ENV=development
SECRET_KEY=ganti-dengan-string-acak-yang-panjang

# Opsi A: koneksi per komponen (MySQL)
DB_DRIVER=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_whs_planner

# Opsi B: URI penuh (jika diisi, menimpa opsi A)
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/db_whs_planner
# DATABASE_URL=postgresql+psycopg2://user:pass@127.0.0.1:5432/db_whs_planner

CORS_ORIGINS=*
